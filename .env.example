# Database Credentials (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-example-123456.region.aws.neon.tech/neondb?sslmode=require"

# Environment Setup
NODE_ENV="development"
PORT="5000"

# Initial Admin Seed Credentials (Used during `npx prisma db seed`)
ADMIN_EMAIL="mahmudkishor9@gmail.com"
ADMIN_PASSWORD="your-secure-admin-password"

# Server Authentication Secret
AUTH_SECRET="your-super-secret-auth-key-change-in-production"

# Cloudinary Server Credentials (Phase 5)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# SMTP Email Configuration (For Forgot Password OTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Family Photo Gallery <noreply@yourdomain.com>"

