# Database Credentials (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-example-123456.region.aws.neon.tech/neondb?sslmode=require"

# Environment Setup
NODE_ENV="development"
PORT="5000"

# Initial Admin Seed Credentials (Used during `npx prisma db seed`)
ADMIN_EMAIL="admin@familyphoto.local"
ADMIN_PASSWORD="change-me-secure-password"

# Server Authentication Secret
AUTH_SECRET="your-super-secret-auth-key-change-in-production"

# Cloudinary Server Credentials (Phase 5)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
